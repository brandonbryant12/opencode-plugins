{
  "name": "opencode-churn",
  "version": "0.2.0",
  "description": "A simple /goal loop for OpenCode 2: implement slices, review, fix, and run ten focused review rounds.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonbryant12/opencode-churn.git"
  },
  "keywords": [
    "opencode",
    "opencode2",
    "plugin",
    "agents",
    "code-review"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "examples",
    "bunfig.toml"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=2 test/*.test.ts",
    "test:native": "node --experimental-strip-types scripts/native-smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-19157"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
