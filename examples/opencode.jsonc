{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      // Install the tagged checkout and dependencies first; use its absolute path.
      "package": "/absolute/path/to/opencode-churn",
      "options": {
        // Omitting model inherits the model selected in your OpenCode session.
        "concurrency": 2,
        "maxCalls": 256,
        "maxSlices": 30,
        "maxFixRounds": 5,
        "cleanAudits": 2,
        "steps": 40,
        "maxHours": 8,
        "keepAwake": true,
        "checks": [
          // Replace with your repository's commands that terminate, not watchers.
          { "name": "check", "command": ["npm", "run", "check"] }
        ]
        // Optional: "heavyCommand": ["/absolute/path/to/resource-gate", "--"]
        // Optional: "models": { "reviewer": "provider/model#variant" }
        // Omitting reviewers uses all six built-in lenses.
      }
    }
  ]
}
